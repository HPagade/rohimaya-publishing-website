# PhoenixForge AI - Streamlit Demo Environment Variables

# OpenAI API Key (Required for real API calls)
# Get your key from: https://platform.openai.com/api-keys
# Leave empty to use Demo Mode with mock data
OPENAI_API_KEY=

# Optional: Set a custom API base URL (for Azure OpenAI, etc.)
# OPENAI_API_BASE=

# Optional: Set organization ID if using OpenAI organization
# OPENAI_ORG_ID=
