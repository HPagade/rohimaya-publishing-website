# ============================================
# PhoenixForge AI - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to git!

# ============================================
# FRONTEND (React App)
# ============================================

# Clerk Authentication
# Get from: https://dashboard.clerk.com
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Supabase
# Get from: https://app.supabase.com > Project Settings > API
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key_here

# API URL (backend)
# Development: http://localhost:5000
# Production: https://your-backend.railway.app
REACT_APP_API_URL=http://localhost:5000

# Stripe (Frontend)
# Get from: https://dashboard.stripe.com/test/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# ============================================
# BACKEND (Node.js API) - Create server/.env
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS
# Development: http://localhost:3000
# Production: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Clerk Authentication (Backend)
# Same as frontend, but get the secret key
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Supabase (Backend)
# Use SERVICE ROLE key (has admin access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# Stripe (Backend)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Price IDs (get after creating products)
STRIPE_PRICE_FREE=free
STRIPE_PRICE_PRO=price_your_pro_price_id_here
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_price_id_here

# ============================================
# SETUP CHECKLIST
# ============================================

# [ ] 1. Create Clerk account and get API keys
# [ ] 2. Create Supabase project and run database-schema.sql
# [ ] 3. Create OpenAI account and get API key
# [ ] 4. Create Stripe account and create products
# [ ] 5. Copy this file to .env in root directory
# [ ] 6. Copy values to server/.env in server directory
# [ ] 7. npm install in both root and server directories
# [ ] 8. Start backend: cd server && npm run dev
# [ ] 9. Start frontend: npm start (in root directory)
# [ ] 10. Visit http://localhost:3000

# ============================================
# COST ESTIMATES (Monthly)
# ============================================

# Clerk: FREE (up to 10K users)
# Supabase: FREE (up to 500MB database, 1GB storage)
# Vercel/Railway: $0-20 (hosting)
# OpenAI: Variable ($10-50 depending on usage)
# Stripe: FREE (2.9% + $0.30 per transaction)

# Total: ~$10-70/month depending on usage
# Break-even: 1-2 paid customers

# ============================================
# QUICK REFERENCE - API Keys Locations
# ============================================

# Clerk:
# 1. Go to https://dashboard.clerk.com
# 2. Select your application
# 3. Go to "API Keys"
# 4. Copy "Publishable Key" and "Secret Key"

# Supabase:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy "URL" and "anon public" (for frontend)
# 5. Copy "service_role" (for backend - keep secret!)

# OpenAI:
# 1. Go to https://platform.openai.com
# 2. Click profile icon > "View API Keys"
# 3. Click "Create new secret key"
# 4. Copy the key (shown only once!)

# Stripe:
# 1. Go to https://dashboard.stripe.com
# 2. Toggle "Test mode" on (top right)
# 3. Go to Developers > API Keys
# 4. Copy "Publishable key" and "Secret key"

# ============================================
# SECURITY NOTES
# ============================================

# NEVER commit .env file to git
# NEVER share your secret keys
# NEVER use production keys in development
# ALWAYS use environment variables, never hardcode keys
# ALWAYS use test mode in Stripe for development
