# ==============================================
# PHOENIXFORGE AI - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your values

# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Frontend URL (for redirects after checkout)
FRONTEND_URL=http://localhost:3000

# ==============================================
# DATABASE (PostgreSQL)
# ==============================================
# Get this from Railway/Supabase/Render after creating a PostgreSQL database
# Example: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://localhost:5432/phoenixforge

# ==============================================
# AUTHENTICATION - CLERK
# ==============================================
# Get these from: https://dashboard.clerk.com
# 1. Create a new application
# 2. Go to API Keys
# 3. Copy the values below

CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================
# PAYMENTS - STRIPE
# ==============================================
# Get these from: https://dashboard.stripe.com
# 1. Create account
# 2. Go to Developers > API Keys
# 3. Get your Secret Key

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Webhook Secret (for production webhooks)
# Get this after creating a webhook endpoint in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs (create these in Stripe Dashboard > Products)
# Create 3 products with recurring prices:
STRIPE_PRICE_AUTHOR=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PUBLISHER=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================
# AI SERVICES - OPENAI
# ==============================================
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================
# OPTIONAL: FILE STORAGE - CLOUDFLARE R2
# ==============================================
# If using Cloudflare R2 for file storage (recommended for production)
# Get these from Cloudflare Dashboard > R2

R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=phoenixforge-files
