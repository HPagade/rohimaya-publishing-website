# PhoenixForge AI - Environment Variables Template
# Copy this file to .env.local and fill in your values

# P0: NextAuth.js Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/phoenixforge

# LLM APIs
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key  # For Writer (Claude)
OPENAI_API_KEY=sk-your-openai-key            # For Format/Covers/Images
ELEVENLABS_API_KEY=your-elevenlabs-key       # For Voice/Audiobook

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=phoenixforge-files
AWS_REGION=us-east-1

# P3: Python Compute Environment (External audiobook processor)
PYTHON_COMPUTE_URL=https://your-compute-endpoint.com/generate
PYTHON_COMPUTE_SECRET=your-compute-auth-secret

# P2: n8n Webhook Proxy (Temporary)
N8N_STRIPE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/stripe

# Optional: Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
